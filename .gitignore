# Virtual environments
.venv/
venv/
ENV/
env/

# Environment secrets
.env
*.env.local

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Data directories (keep directory structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep

# Generated reports & models
reports/*.html
reports/*.json
reports/*.csv
!reports/.gitkeep

# IDE & OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
